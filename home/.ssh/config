# SSH config, shipped by the base toolkit.
#
# Per-machine overrides (work account keys, throwaway hosts) go in
# ~/.ssh/config.local, which no toolkit ships.

# Per-machine include first so its specific Host entries match before the
# wildcards below.
Include ~/.ssh/config.local

# Host entries shipped by other toolkits. Also before the wildcards: ssh
# keeps the first value it finds for each option.
Include ~/.ssh/config.d/*

# Personal GitHub via the YubiKey-resident GPG AUT subkey, presented over
# $SSH_AUTH_SOCK by gpg-agent. With `IdentitiesOnly yes`, SSH filters the
# agent's keys against IdentityFile pubkeys -- so we explicitly point at
# a dumped copy of the YubiKey AUT pubkey. Without this, SSH only tries
# the default ~/.ssh/id_{rsa,ecdsa,ed25519,...} names (which don't exist)
# and ignores the YubiKey entirely.
Host github.com
  User git
  IdentityFile ~/.ssh/id_yubikey_auth.pub
  IdentitiesOnly yes
  AddKeysToAgent yes

# Defaults for everything else.
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Connection multiplexing. The YubiKey AUT subkey is touch policy "Cached
  # (fixed)" -- one touch covers 15s and the policy can't be loosened without
  # resetting the OpenPGP applet. So the only way to cut touch prompts is to
  # authenticate less: the first ssh to a host opens a master socket, every
  # later ssh to the same host rides it with no new auth. herdr's per-machine
  # connections and `herdr machine add` (which fires several ssh invocations
  # back to back) collapse to one touch per host per 10 minutes.
  # %C hashes host/port/user so the socket path can't exceed the ~104 char
  # unix socket limit.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
