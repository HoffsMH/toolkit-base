# Shared Ghostty entry point.
# set.links installs one platform overlay on each host.
theme = Gruvbox Dark
window-theme = auto
window-padding-x = 2
window-padding-y = 2
font-family = "monospace"
font-style = Regular
font-size = 13
confirm-close-surface = false
resize-overlay = never
cursor-style = "block"
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env
mouse-scroll-multiplier = precision:1,discrete:6
keybind = shift+enter=csi:13;2u
config-file = ?~/.config/ghostty/config.mac
config-file = ?~/.config/ghostty/config.linux
