#!/usr/bin/env bash
# Link each toolkit's home/ into $HOME with GNU stow, plus home-linux/ or
# home-darwin/ for this OS. A file belongs to exactly one of them; stow
# refuses a target two of them provide. A machine's toolkits are whatever is
# cloned under $TOOLKITS_DIR.
# Restows, so links to files deleted from a toolkit are removed too.
# root/ is copied, not linked: see root.set.
set -euo pipefail

# usage ok: help on stdout, exit 0. Otherwise a usage error.
usage() {
  local fd=2 rc=2
  [ "${1:-}" = ok ] && fd=1 rc=0
  {
    printf 'Usage: %s [-n] [-v] [-b] [-D] [toolkit...]\n' "${0##*/}"
    printf '  -n  dry run (implies -v)\n  -v  list each link\n'
    printf '  -b  move a regular file in the way to <file>.pre-toolkit first,\n'
    printf '      and replace dangling links and links into the old infra layout\n'
    printf '  -D  remove the links instead\n'
    printf '  -h, --help  show this help\n'
    printf 'Env: TOOLKITS_DIR (default ~/infra/toolkits),\n'
    printf '     LINKS_LEGACY_DIR (default ~/infra/assets)\n'
  } >&"$fd"
  exit "$rc"
}

[ "${1:-}" = --help ] && usage ok

toolkits_dir=${TOOLKITS_DIR:-$HOME/infra/toolkits}
legacy_dir=$(readlink -m "${LINKS_LEGACY_DIR:-$HOME/infra/assets}")
action=--restow
dry_run=false
verbose=0
backup=false

while getopts nvbDh opt; do
  case $opt in
    h) usage ok ;;
    n) dry_run=true; verbose=1 ;;
    v) verbose=1 ;;
    b) backup=true ;;
    D) action=--delete ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

command -v stow >/dev/null || { echo "links.set: needs GNU stow" >&2; exit 1; }
[ -d "$toolkits_dir" ] || { echo "links.set: no $toolkits_dir" >&2; exit 1; }

if [ $# -eq 0 ]; then
  set --
  for d in "$toolkits_dir"/*/; do set -- "$@" "$(basename "$d")"; done
fi

stow_flags=(--no-folding "--verbose=$verbose" --target="$HOME" "$action")
$dry_run && stow_flags+=(--simulate)

# Stow treats absolute symlinks as foreign. Drop one that already resolves to
# the toolkit's own file so stow can replace it with a relative link; the
# dropped ones are recorded so a failed stow can put them back.
dropped=()
drop_absolute_links() {
  local src=$1 f t
  while IFS= read -r -d '' f; do
    t="$HOME/${f#"$src"/}"
    [ -L "$t" ] && [[ $(readlink "$t") == /* ]] || continue
    [ "$(readlink -f "$t")" = "$(readlink -f "$f")" ] || continue
    if $dry_run; then
      echo "would relink: ${t#"$HOME"/}"
    else
      dropped+=("$t" "$(readlink "$t")")
      rm "$t"
    fi
  done < <(find "$src" -type f -print0)
}

# With -b, a regular file where a link should go (a distro default, say) is
# moved aside rather than reported as a conflict, and a dangling link or a
# link into the old infra layout is dropped (its target stays in that repo).
# An old link on a parent folder (dangling, or into the old layout) hides
# every file under it from stow; drop it the same way.
drop_old_parent() {
  local rel=$1 p=$HOME part parts
  IFS=/ read -r -a parts <<<"${rel%/*}"
  for part in "${parts[@]}"; do
    p=$p/$part
    [ -L "$p" ] || continue
    [ ! -e "$p" ] || [[ $(readlink -m "$p") == "$legacy_dir"/* ]] || continue
    if $dry_run; then
      echo "would replace old folder link: ${p#"$HOME"/} -> $(readlink "$p")"
    else
      dropped+=("$p" "$(readlink "$p")")
      echo "replacing old folder link: ${p#"$HOME"/} -> $(readlink "$p")"
      rm "$p"
    fi
    return
  done
}

moved=()
move_aside() {
  local src=$1 f t rel
  while IFS= read -r -d '' f; do
    rel=${f#"$src"/}
    [[ $rel != */* ]] || drop_old_parent "$rel"
    t="$HOME/$rel"
    if [ -L "$t" ] && { [ ! -e "$t" ] || [[ $(readlink -m "$t") == "$legacy_dir"/* ]]; }; then
      if $dry_run; then
        echo "would replace old link: ${t#"$HOME"/} -> $(readlink "$t")"
      else
        dropped+=("$t" "$(readlink "$t")")
        echo "replacing old link: ${t#"$HOME"/} -> $(readlink "$t")"
        rm "$t"
      fi
      continue
    fi
    [ -f "$t" ] && [ ! -L "$t" ] || continue
    [ ! -e "$t.pre-toolkit" ] || { echo "links.set: $t.pre-toolkit exists, not moving $t" >&2; continue; }
    if $dry_run; then
      echo "would move aside: ${t#"$HOME"/}"
    else
      mv "$t" "$t.pre-toolkit"
      moved+=("$t")
      echo "moved aside: ${t#"$HOME"/} -> ${t#"$HOME"/}.pre-toolkit"
    fi
  done < <(find "$src" -type f -print0)
}

restore_dropped() {
  local i t
  for ((i = 0; i < ${#dropped[@]}; i += 2)); do
    ln -s "${dropped[i + 1]}" "${dropped[i]}"
  done
  for t in "${moved[@]}"; do mv "$t.pre-toolkit" "$t"; done
}

os=$(uname | tr '[:upper:]' '[:lower:]')

failed=()
for name in "$@"; do
  pkg="$toolkits_dir/$name"
  dirs=()
  for d in home "home-$os"; do [ ! -d "$pkg/$d" ] || dirs+=("$d"); done
  [ ${#dirs[@]} -gt 0 ] || { echo "== $name: no home/ or home-$os/, skipped"; continue; }
  echo "== $name"
  dropped=() moved=()
  for d in "${dirs[@]}"; do
    # Linked files land in $HOME, so keep them private to this user.
    $dry_run || chmod -R go-rwx "$pkg/$d"
    [ "$action" = --delete ] || drop_absolute_links "$pkg/$d"
    [ "$action" = --delete ] || ! $backup || move_aside "$pkg/$d"
  done
  # stow logs on stderr; send it to stdout so callers can pipe it.
  if ! stow --dir="$pkg" "${stow_flags[@]}" "${dirs[@]}" 2>&1; then
    failed+=("$name")
    restore_dropped
  fi
done

# Files built from pieces (see pieces.build) are rebuilt after every link
# change, so they follow the toolkits that are linked right now.
hooks=${XDG_CONFIG_HOME:-$HOME/.config}/toolkits/after-link.d
if ! $dry_run && [ -d "$hooks" ]; then
  for h in "$hooks"/*; do
    [ -x "$h" ] || continue
    "$h" || echo "links.set: hook ${h##*/} failed" >&2
  done
fi

if [ ${#failed[@]} -gt 0 ]; then
  printf '\nlinks.set: conflicts in: %s\n' "${failed[*]}" >&2
  printf 'Stow skipped those toolkits entirely. Move or adopt each listed file, then rerun.\n' >&2
  exit 1
fi
