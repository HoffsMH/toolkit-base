#!/usr/bin/env bash
set -euo pipefail

readonly working_dir=.
readonly command_name=${1:-lazygit}
readonly window_name=lazygit
readonly current_session=$(tmux display-message -p '#S')

if ! tmux list-windows -t "$current_session" -F '#W' | grep -Fxq "$window_name"; then
  tmux new-window -n "$window_name" -c "$working_dir" "$command_name"
else
  tmux select-window -t "${current_session}:${window_name}"
fi
