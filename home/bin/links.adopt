#!/usr/bin/env bash
# Move one regular file from $HOME into a toolkit and link it back, so the
# toolkit owns it from now on. Refuses (and changes nothing) when the file is
# a link, a folder, outside $HOME, already in a toolkit, or when the toolkit
# already ships that path.
set -euo pipefail

# macOS readlink has no -m; Homebrew's coreutils ships GNU's as greadlink.
if command -v greadlink >/dev/null; then readlink() { greadlink "$@"; }; fi

usage() { printf 'Usage: %s [-n] [-o] TOOLKIT FILE\n  -n  dry run\n  -o  this OS only (home-linux/ or home-darwin/)\n' "${0##*/}" >&"${1:-2}"; exit "${2:-2}"; }
dry_run=false os_only=false
while getopts noh opt; do
  case $opt in
    n) dry_run=true ;;
    o) os_only=true ;;
    h) usage 1 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 2 ] || usage

toolkits_dir=$(readlink -m "${TOOLKITS_DIR:-$HOME/infra/toolkits}")
kit=$1 file=$(readlink -m "$2")
os=$(uname | tr '[:upper:]' '[:lower:]')
no() { echo "links.adopt: $*; nothing changed" >&2; exit 1; }

[ -d "$toolkits_dir/$kit" ] || no "no toolkit $toolkits_dir/$kit"
[ ! -L "$2" ] || no "$2 is already a link -> $(readlink "$2")"
[ -f "$file" ] || no "$2 is not a regular file"
[[ $file == "$HOME"/* ]] || no "$file is outside \$HOME"
[[ $file != "$toolkits_dir"/* ]] || no "$file is already inside a toolkit"

rel=${file#"$HOME"/}
for d in home "home-$os"; do
  [ ! -e "$toolkits_dir/$kit/$d/$rel" ] || no "$kit already ships $d/$rel"
done
dir=home
! $os_only || dir=home-$os
dest=$toolkits_dir/$kit/$dir/$rel

echo "adopt ~/$rel -> $kit/$dir/$rel"
$dry_run && exit 0
mkdir -p "$(dirname "$dest")"
mv "$file" "$dest"
if ! "$(dirname "$0")/links.set" "$kit"; then
  mv "$dest" "$file"
  no "links.set failed; moved the file back"
fi
