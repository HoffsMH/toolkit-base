#!/usr/bin/env bash
# Remove broken links in $HOME that point into a toolkit or the old infra
# layout: leftovers from files a toolkit dropped or never ported. Shows what
# it would remove unless given --apply. Never touches other broken links.
set -euo pipefail

# macOS readlink has no -m; Homebrew's coreutils ships GNU's as greadlink.
if command -v greadlink >/dev/null; then readlink() { greadlink "$@"; }; fi

apply=false
case ${1:-} in
  --apply) apply=true ;;
  -h | --help)
    printf 'Usage: %s [--apply]\n\nList (or with --apply remove) broken links into toolkits or the old layout.\n' "${0##*/}"
    exit 0 ;;
  "") ;;
  *) echo "Usage: ${0##*/} [--apply]" >&2; exit 2 ;;
esac

toolkits_dir=$(readlink -m "${TOOLKITS_DIR:-$HOME/infra/toolkits}")
read -r -a old_dirs <<<"${LINKS_OLD_DIRS:-$HOME/old-infra $HOME/infra/assets}"
roots=("$toolkits_dir")
for o in "${old_dirs[@]}"; do roots+=("$(readlink -m "$o")"); done

n=0
while IFS= read -r -d '' l; do
  [ ! -e "$l" ] || continue
  t=$(readlink -m "$l")
  for r in "${roots[@]}"; do
    [[ $t == "$r"/* ]] || continue
    n=$((n + 1))
    if $apply; then command rm "$l"; echo "removed ${l#"$HOME"/}"; else echo "would remove ${l#"$HOME"/} -> $(readlink "$l")"; fi
    break
  done
done < <(find "$HOME" -xdev \( -path "$HOME/.cache" -o -path "$HOME/.local/share" -o -path "$toolkits_dir" \
  -o -path "$HOME/old-infra" -o -name node_modules -o -name .git \) -prune -o -type l -print0 2>/dev/null)

$apply || [ $n -eq 0 ] || echo "Run ${0##*/} --apply to remove these $n link(s)."
