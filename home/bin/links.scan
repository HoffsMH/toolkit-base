#!/usr/bin/env bash
# Read-only report on how $HOME relates to the toolkits: links per toolkit,
# broken links, links still into the old infra layout, built files whose
# program edited them, and files links.set or pieces.build set aside.
set -euo pipefail

case ${1:-} in
  -h | --help)
    printf 'Usage: %s\n\nReport toolkit links, broken links, old-layout links and leftovers in ~.\n' "${0##*/}"
    printf 'Env: TOOLKITS_DIR (default ~/infra/toolkits), LINKS_OLD_DIRS (default ~/old-infra ~/infra/assets)\n'
    exit 0 ;;
  "") ;;
  *) echo "Usage: ${0##*/}" >&2; exit 2 ;;
esac

toolkits_dir=$(readlink -m "${TOOLKITS_DIR:-$HOME/infra/toolkits}")
read -r -a old_dirs <<<"${LINKS_OLD_DIRS:-$HOME/old-infra $HOME/infra/assets}"
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/toolkits/pieces

# Big trees no toolkit links into.
home_find() {
  find "$HOME" -xdev \( -path "$HOME/.cache" -o -path "$HOME/.local/share" -o -path "$toolkits_dir" \
    -o -path "$HOME/old-infra" -o -name node_modules -o -name .git \
    -o -path "$HOME/.var" -o -path "$HOME/.npm" -o -path "$HOME/.cargo" -o -path "$HOME/go" \) -prune \
    -o "$@" -print0 2>/dev/null
}

declare -A per_kit=()
broken=() old=()
while IFS= read -r -d '' l; do
  t=$(readlink -m "$l")
  rel=${l#"$HOME"/}
  if [[ $t == "$toolkits_dir"/* ]]; then
    kit=${t#"$toolkits_dir"/}; kit=${kit%%/*}
    if [ -e "$l" ]; then per_kit[$kit]=$((${per_kit[$kit]:-0} + 1)); else broken+=("$rel -> $(readlink "$l")"); fi
    continue
  fi
  for o in "${old_dirs[@]}"; do
    o=$(readlink -m "$o")
    [[ $t == "$o"/* ]] || continue
    if [ -e "$l" ]; then old+=("$rel -> $(readlink "$l")"); else broken+=("$rel -> $(readlink "$l")"); fi
    break
  done
done < <(home_find -type l)

leftovers=()
while IFS= read -r -d '' f; do leftovers+=("${f#"$HOME"/}"); done < <(home_find \( -name '*.pre-toolkit' -o -name '*.drift-*' \))

echo "== links per toolkit"
if [ ${#per_kit[@]} -eq 0 ]; then echo "  (none)"; fi
for k in $(printf '%s\n' "${!per_kit[@]}" | sort); do printf '  %-20s %d\n' "$k" "${per_kit[$k]}"; done

echo "== broken links into toolkits or the old layout (links.prune removes them)"
if [ ${#broken[@]} -eq 0 ]; then echo "  (none)"; else printf '  %s\n' "${broken[@]}"; fi

echo "== links still into the old layout (port them into a toolkit)"
if [ ${#old[@]} -eq 0 ]; then echo "  (none)"; else printf '  %s\n' "${old[@]}"; fi

echo "== set aside by links.set (.pre-toolkit) or pieces.build (.drift-*)"
if [ ${#leftovers[@]} -eq 0 ]; then echo "  (none)"; else printf '  %s\n' "${leftovers[@]}"; fi

if [ -d "$state_dir" ]; then
  echo "== files built by pieces.build"
  for o in "$state_dir"/*.out; do
    [ -e "$o" ] || continue
    f=$(cat "$o")
    stamp=${o%.out}
    [ -f "$stamp" ] || continue
    if [ -f "$f" ] && [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$(cat "$stamp")" ]; then s=current; else s="edited since built"; fi
    printf '  %-34s %s\n' "${f#"$HOME"/}" "$s"
  done
fi
