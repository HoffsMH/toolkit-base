#!/usr/bin/env bash
# Install one toolkit from $TOOLKITS_DIR/<name>: packages, home links, root
# files, setup.d, then verify.d, then NEXT.txt last so it stays on screen.
# Safe to rerun. A failing verify.d is reported, not fatal, since NEXT.txt
# usually holds the manual steps it is waiting on.
set -euo pipefail

# Setup scripts call base's commands by name; a bare ssh or a first boot may
# not have ~/bin on PATH yet.
PATH="$(cd "$(dirname "$0")" && pwd):$HOME/bin:$PATH"
# Nor Homebrew's, which a non-login shell on macOS lacks.
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ "$(uname)" = Darwin ] && [ -x "$b" ]; then eval "$("$b" shellenv)"; break; fi
done

toolkits_dir=${TOOLKITS_DIR:-$HOME/infra/toolkits}
name=${1:?usage: toolkit.install <toolkit>}
tk=$toolkits_dir/$name
[ -d "$tk" ] || { echo "toolkit.install: no $tk" >&2; exit 1; }

say() { printf '\n== %s: %s\n' "$name" "$*"; }

lines() { [ -f "$1" ] && grep -v '^\s*\(#\|$\)' "$1" || true; }

# "a|b" in a package list: any one of them will do. Skip the line when one is
# installed (a machine may already have the other build of the same thing),
# else install the first.
pick() {
  local line alt
  while read -r line; do
    [[ $line == *"|"* ]] || { echo "$line"; continue; }
    for alt in ${line//|/ }; do
      pacman -Qq "$alt" >/dev/null 2>&1 && continue 2
    done
    echo "${line%%|*}"
  done
}

# A cask installed from the vendor rather than brew counts as installed: its
# app is in /Applications, or its pkg left a receipt. brew would refuse the
# app, and would reinstall the pkg over the running one.
cask_present() {
  local kind id
  brew list --cask "$1" >/dev/null 2>&1 && return 0
  while read -r kind id; do
    case $kind in
      app) [ -e "/Applications/$id" ] && return 0 ;;
      pkg) pkgutil --pkg-info "$id" >/dev/null 2>&1 && return 0 ;;
    esac
  done < <(brew info --cask --json=v2 "$1" | jq -r '.casks[].artifacts[]
    | ((.app? // [])[] | strings | "app \(.)"),
      ((.uninstall? // [])[] | objects | .pkgutil? // empty | (if type == "array" then .[] else . end) | "pkg \(.)")')
  return 1
}

install_packages() {
  local pkgs
  if [ "$(uname)" = Darwin ]; then
    # Skip what is installed: brew install would upgrade it.
    lines "$tk/packages/brew.txt" | while read -r a b; do
      if [ "$a" = cask ]; then
        cask_present "$b" || brew install --cask "$b"
      else
        brew list --formula "$a" >/dev/null 2>&1 || brew install "$a"
      fi
    done
    return
  fi
  pkgs=$(lines "$tk/packages/pacman.txt" | pick)
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || sudo pacman -S --needed --noconfirm $pkgs
  pkgs=$(lines "$tk/packages/aur.txt" | pick)
  # shellcheck disable=SC2086
  [ -z "$pkgs" ] || yay -S --needed --noconfirm $pkgs
}

# Root files are copied, never linked: a root config linked into a repo this
# user can write would let this user change root config.
install_root_files() {
  local f dst mode
  while IFS= read -r -d '' f; do
    dst=/${f#"$tk/root/"}
    mode=644
    [ -x "$f" ] && mode=755
    [[ $dst == /etc/sudoers.d/* ]] && mode=440
    if sudo cmp -s "$f" "$dst" 2>/dev/null; then continue; fi
    if [[ $dst == /etc/sudoers.d/* ]] && ! sudo visudo -cqf "$f"; then
      echo "toolkit.install: $f fails visudo, not installed" >&2
      return 1
    fi
    # No install -D or group "root" on macOS: make the folder first, and use
    # gid 0 (root on Linux, wheel on macOS).
    sudo mkdir -p "$(dirname "$dst")"
    sudo install -o root -g 0 -m "$mode" "$f" "$dst"
    echo "installed $dst"
  done < <(find "$tk/root" -type f -print0)
}

if [ -d "$tk/packages" ]; then say packages; install_packages; fi
os=$(uname | tr '[:upper:]' '[:lower:]')
if [ -d "$tk/home" ] || [ -d "$tk/home-$os" ]; then say links; "$(dirname "$0")/links.set" -b "$name"; fi
if [ -d "$tk/root" ]; then say "root files"; install_root_files; fi

for s in "$tk"/setup.d/*.sh; do
  [ -e "$s" ] || continue
  say "setup ${s##*/}"
  bash "$s"
done

verify_failed=0
for s in "$tk"/verify.d/*.sh; do
  [ -e "$s" ] || continue
  say "verify ${s##*/}"
  bash "$s" || verify_failed=1
done

if [ -f "$tk/NEXT.txt" ]; then
  printf '\n'
  cat "$tk/NEXT.txt"
fi
[ $verify_failed -eq 0 ] || printf '\n%s: some checks failed; see verify output above.\n' "$name"
